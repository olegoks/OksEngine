PacketManagerNamespace = {
    TagComponent = {},
    RepositoryOwnerComponent = {
        fields = {
            { type = "std::string", name = "owner" }
        }
    },
    RepositoryNameComponent = {
        fields = {
            { type = "std::string", name = "name" }
        }
    },
    RequiredPackagesComponent = {
        fields = {
            { type = "std::vector<ECS2::Entity::Id>", name = "required" },
        }
    },
    ResolvedPackagesComponent = {
        fields = {
            { type = "std::unordered_map<std::string, std::tuple<Common::UInt64, Common::UInt64, Common::UInt64>>", name = "resolved" },
        }
    },
    ECSProjectFilePathComponent = {
        fields = {
            { type = "std::string", name = "path" }
        }
    },
    PackageNamespace = {
        TagComponent = {},
        NameComponent = {
            fields = {
                { type = "std::string", name = "name" },
            }
        },
        DependenciesComponent = {
            fields = {
                { type = "std::vector<ECS2::Entity::Id>", name = "dependecies" },
            }
        },
        PackageArchetype = {
            components = {
                "Package::Tag",
                "Name",
                "Dependencies",
                "Version"
            }
        }
    },

    GetRequiredPacketsSystem = {
        type = "Initialize",
        updateMethod = {
            processesEntities = {
                {
                    processesComponents = {
                        "CommandLineParameters",
                        "ExecutablePath",
                        "ECSProjectFilePath"
                    }
                }
            }
        }
    },

    GetPacketsToDownloadSystem = {
        description = "Check packets dependecies, and get packets and their versions and need to download",
        type = "Initialize",
        callOrder = {
            runAfter = "GetRequiredPackets"
        },
        updateMethod = {
            processesEntities = {
                {
                    processesComponents = {
                        "PacketManager::Tag",
                        "PacketManager::RequiredPackages"
                    }
                }
            },
            accessingEntities = {
                {
                    archetype = "Package::Package"
                }
            }
        }
    }
}
